NODE_ENV=development
PORT=4474

# PostgreSQL connection
DATABASE_URL=postgresql://carma:carma_dev_password@localhost:5432/carma
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=carma
POSTGRES_PASSWORD=carma_dev_password
POSTGRES_DB=carma

# OpenRouter LLM API
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_ENRICHMENT_MODEL=qwen/qwen3.6-35b-a3b
OPENROUTER_TIMEOUT_MS=30000
OPENROUTER_MAX_RETRIES=2

# Enrichment guardrails
LLM_MAX_HEADLINE_CHARS=512
LLM_MAX_BODY_CHARS=8000
LLM_MAX_OUTPUT_TOKENS=400
LLM_DAILY_BUDGET_USD=5
